[TEMPLATE]
# Afterglow frontend environment (copy to frontend/.env)
# Placeholders only — never put a real key in this file, it is tracked by Git.
# All variables are optional for local development.

# Base URL for the Afterglow API.
# Leave unset to use the same-origin default '/api/v1', which works with the
# Vite dev proxy below and with a production reverse proxy.
# VITE_API_URL=http://localhost:5000/api/v1

# Where the Vite dev server proxies '/api' requests (development only).
# VITE_PROXY_TARGET=http://localhost:5000

# Google sign-in (Supabase as the OAuth broker).
#
# Use the PUBLISHABLE key from Supabase → Project Settings → API Keys
# (sb_publishable_…), or a legacy anon key (a JWT whose role is "anon").
# Vite inlines every VITE_ variable into the shipped browser bundle, so a
# secret key (sb_secret_…) or a service_role key must never appear here — those
# bypass row level security. The app refuses to enable Google sign-in with one
# and logs why, rather than publishing it.
#
# The API verifies the resulting token with its own SUPABASE_URL /
# SUPABASE_ANON_KEY pair (see backend/.env.example); the same publishable key is
# correct in both places.
#
# When these are unset or unusable, the "Continue with Google" button is not
# rendered at all and the email form is unchanged.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Trailing slash must not be included.
