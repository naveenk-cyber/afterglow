# Afterglow frontend environment (copy to frontend/.env)
# All variables are optional for local development.

# Base URL for the Afterglow API.
# Leave unset to use the same-origin default '/api/v1', which works with the
# Vite dev proxy below and with a production reverse proxy.
# VITE_API_URL=http://localhost:5000/api/v1

# Where the Vite dev server proxies '/api' requests (development only).
# VITE_PROXY_TARGET=http://localhost:5000

# Trailing slash must not be included.
