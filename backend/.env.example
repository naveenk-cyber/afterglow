# Afterglow backend environment (copy to backend/.env and adjust)
# Never commit the real .env file.

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# REQUIRED in production. Used to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Session lifetime in hours
SESSION_TTL_HOURS=168

# SQLite database file (relative paths resolve from backend/)
DATABASE_FILE=./data/chargeease.db

# Public base URL of the frontend, used to build password-reset links
PUBLIC_APP_URL=http://localhost:5173

# Base currency + display units for stored prices
CURRENCY=USD
DISTANCE_UNIT=miles
