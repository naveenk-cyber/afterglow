# Afterglow production environment (Vercel + Turso)
# Copy the values into Vercel → Project → Settings → Environment Variables.
# These are placeholders only. Never commit real credentials.

# Turso database (create a free database at https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=

# REQUIRED in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public URL of the deployed site (used for password-reset links)
PUBLIC_APP_URL=https://your-project.vercel.app

# Comma-separated browser origins allowed to call the API.
# For a same-origin Vercel deployment the site URL is enough.
CORS_ORIGIN=https://your-project.vercel.app

# Session lifetime in hours
SESSION_TTL_HOURS=168

# Seed the sample station catalogue into an empty database.
SEED_ON_START=true

# Opt in to the documented demo driver account on the public demo.
SEED_DEMO_USER=true

# Base currency + display units for stored prices
CURRENCY=USD
DISTANCE_UNIT=miles
