# Afterglow production environment (Vercel + Turso)
# Copy the values into Vercel → Project → Settings → Environment Variables.
# These are placeholders only. Never commit real credentials.

# Turso database (create a free database at https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=

# REQUIRED in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public URL of the deployed site (used for password-reset links)
PUBLIC_APP_URL=https://your-project.vercel.app

# Comma-separated browser origins allowed to call the API.
# For a same-origin Vercel deployment the site URL is enough.
CORS_ORIGIN=https://your-project.vercel.app

# Session lifetime in hours
SESSION_TTL_HOURS=168

# Seed the sample station catalogue into an empty database.
SEED_ON_START=true

# Opt in to the documented demo driver account on the public demo.
SEED_DEMO_USER=true

# Base currency + display units for stored prices
CURRENCY=USD
DISTANCE_UNIT=miles

# Google sign-in (Supabase as the OAuth broker). Add all four names in Vercel:
# the two VITE_ ones are inlined into the browser bundle at build time, the
# other two are read by the API function at runtime. The values are the same
# pair (project URL + PUBLISHABLE key) from Supabase → Project Settings →
# API Keys, and they are public by design.
#
# Use the publishable key (sb_publishable_…) — or a legacy anon key with role
# "anon". Never a secret key (sb_secret_…) or a service_role key: those bypass
# row level security and must stay out of the app entirely. Both the frontend
# and the API detect one and refuse to enable Google sign-in instead of using
# it. No Google client secret belongs in the app either — it stays in the
# Supabase dashboard (Authentication → Providers → Google).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
